{
  "firestore": {
    "rules": "platform/firebase/firestore.rules",
    "indexes": "platform/firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "platform/firebase/storage.rules"
  },
  "hosting": {
    "predeploy": [
      "npm --prefix app run build && node scripts/app-hosting/build.cjs"
    ],
    "public": "dist/app-hosting",
    "ignore": [
      "firebase.json",
      "firebase.marketing.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "platform/**",
      "docs/**",
      "blog/**",
      "lesson-sources/**",
      "mission-control/**",
      "scripts/marketing-hosting/**",
      "dist/marketing/**",
      "wonderbox/**",
      "app/lessons/variants/manifest.json",
      "**/*.md",
      "**/*.map",
      "Leaderboard_GScript.js",
      "LyfeLabz_GScript.js",
      "LyfeLabz_GScript_v2.js",
      "LyfeLabz_GScript_v2_test.js"
    ],
    "redirects": [
      {
        "source": "/privacy",
        "destination": "https://lyfelabz.com/privacy",
        "type": 301
      },
      {
        "source": "/terms",
        "destination": "https://lyfelabz.com/terms",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/app/**",
        "headers": [
          {
            "key": "Referrer-Policy",
            "value": "strict-origin"
          }
        ]
      },
      {
        "source": "/app/lessons/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "script-src 'self' 'unsafe-inline' https://apis.google.com https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/app/signin",
        "destination": "/app/index.html"
      },
      {
        "source": "/app/onboarding",
        "destination": "/app/index.html"
      },
      {
        "source": "/app/pending",
        "destination": "/app/index.html"
      },
      {
        "source": "/app/teacher",
        "destination": "/app/index.html"
      },
      {
        "source": "/app/student",
        "destination": "/app/index.html"
      },
      {
        "source": "/app/a/**",
        "destination": "/app/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "platform/functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "*.log"],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
