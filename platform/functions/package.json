{
  "name": "@lyfelabz/functions",
  "version": "0.0.0",
  "private": true,
  "description": "LyfeLabz Cloud Functions.",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts src",
    "test": "jest",
    "test:watch": "jest --watch",
    "deploy:assessment": "node lib/scripts/deploy-assessment.js",
    "publish:variant": "node lib/scripts/publish-variant.js",
    "prepare:astra004-hosting": "npm run build && node lib/scripts/astra004-hosting-prepare.js",
    "test:astra004-hosting": "jest --runInBand --runTestsByPath src/scripts/astra004-hosting-prepare.test.ts",
    "test:astra004-hosting:mutations": "node scripts/astra004-hosting-mutation-check.cjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.6",
    "firebase-admin": "^12.2.0",
    "firebase-functions": "^5.0.1",
    "google-auth-library": "^9.15.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.6.3"
  }
}
