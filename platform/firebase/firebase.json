{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "predeploy": [
      "node -e \"console.error('REFUSED: platform/firebase/firebase.json Hosting is emulator-only (scripts/ux-review). Production Hosting deploys only from the repository-root firebase.json curated artifact (dist/app-hosting).'); process.exit(1)\""
    ],
    "public": "../..",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "platform/**",
      "docs/**",
      "blog/**",
      "lesson-sources/**"
    ],
    "rewrites": [
      {
        "source": "/app/**",
        "destination": "/app/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "../functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "*.log", "lib"]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
