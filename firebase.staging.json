{
  "hosting": [
    {
      "target": "app",
      "predeploy": [
        "node scripts/hosting-release/build-pair.cjs"
      ],
      "public": "dist/app-hosting",
      "ignore": [
        "firebase.json",
        "firebase.marketing.json",
        ".firebaserc",
        "**/.*",
        "**/node_modules/**",
        "platform/**",
        "docs/**",
        "blog/**",
        "lesson-sources/**",
        "mission-control/**",
        "scripts/marketing-hosting/**",
        "dist/marketing/**",
        "wonderbox/**",
        "app/lessons/variants/manifest.json",
        "**/*.md",
        "**/*.map",
        "Leaderboard_GScript.js",
        "LyfeLabz_GScript.js",
        "LyfeLabz_GScript_v2.js",
        "LyfeLabz_GScript_v2_test.js"
      ],
      "redirects": [
        {
          "source": "/privacy",
          "destination": "https://lyfelabz-staging-marketing.web.app/privacy",
          "type": 301
        },
        {
          "source": "/terms",
          "destination": "https://lyfelabz-staging-marketing.web.app/terms",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "/app/**",
          "headers": [
            {
              "key": "Referrer-Policy",
              "value": "strict-origin"
            }
          ]
        },
        {
          "source": "/app/lessons/**",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "script-src 'self' 'unsafe-inline' https://apis.google.com https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/app/signin",
          "destination": "/app/index.html"
        },
        {
          "source": "/app/onboarding",
          "destination": "/app/index.html"
        },
        {
          "source": "/app/pending",
          "destination": "/app/index.html"
        },
        {
          "source": "/app/teacher",
          "destination": "/app/index.html"
        },
        {
          "source": "/app/student",
          "destination": "/app/index.html"
        },
        {
          "source": "/app/a/**",
          "destination": "/app/index.html"
        }
      ]
    },
    {
      "target": "marketing",
      "public": "dist/marketing",
      "predeploy": [
        "node scripts/hosting-release/build-pair.cjs"
      ],
      "ignore": [],
      "redirects": [
        {
          "source": "/app",
          "destination": "https://lyfelabz-staging.web.app/app/",
          "type": 301
        },
        {
          "source": "/app/",
          "destination": "https://lyfelabz-staging.web.app/app/",
          "type": 301
        },
        {
          "regex": "^/(lesson_[a-z0-9-]+\\.html)$",
          "destination": "https://lyfelabz-staging.web.app/:1",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/privacy",
          "destination": "/privacy.html"
        },
        {
          "source": "/terms",
          "destination": "/terms.html"
        }
      ]
    }
  ]
}
